{
  "name": "sprout-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "ios": "npm run ios --workspace apps/mobile",
    "android": "npm run android --workspace apps/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:mobile": "npm exec --workspace apps/mobile expo config -- --type public --json",
    "format": "prettier --write \"apps/mobile/{app,src}/**/*.{ts,tsx}\" \"packages/{shared,services,design-tokens}/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/mobile/{app,src}/**/*.{ts,tsx}\" \"packages/{shared,services,design-tokens}/src/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vitest": "^4.1.10"
  }
}
