{
  "expo": {
    "name": "Sprout",
    "description": "Water your virtual plants by completing real-life habits. Grow beautiful forests together with friends!",
    "slug": "sprout",
    "scheme": "sprout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your Sprout forest."
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sprout to attach photos to habit reflections and your profile.",
          "cameraPermission": "Allow Sprout to capture photos for habit reflections and your profile."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2D5A27"
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insubj.sprout",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.insubj.sprout",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9341450c-d3cf-4a08-960c-efc4f3f434b8"
      }
    },
    "owner": "ianjeon"
  }
}
